{
  "$comment": "Settings for scripts/check-public-safety.ts. This site is public: nothing that looks like internal Microsoft material may be committed or built. Phrases are specific on purpose; 'confidential' alone is also the name of a sensitivity label.",
  "scan": ["content", "src", "public", "dist", "dist-root", "dist-repo"],
  "skip": ["src/generated"],
  "extensions": [
    ".css",
    ".html",
    ".js",
    ".json",
    ".md",
    ".mjs",
    ".svg",
    ".ts",
    ".tsx",
    ".txt",
    ".webmanifest",
    ".xml",
    ".yaml",
    ".yml"
  ],
  "blockedPhrases": [
    "microsoft confidential",
    "highly confidential - microsoft",
    "confidential and proprietary",
    "internal use only",
    "for internal use",
    "internal only",
    "microsoft internal",
    "internal microsoft",
    "msft internal",
    "for microsoft employees only",
    "not for external distribution",
    "not for external use",
    "do not share",
    "do not forward",
    "do not distribute",
    "limited distribution",
    "under nda",
    "subject to nda",
    "covered by nda",
    "nda only",
    "nda required"
  ],
  "blockedHosts": [
    "sharepoint.com",
    "sharepoint-df.com",
    "1drv.ms",
    "onedrive.live.com",
    "corp.microsoft.com",
    "microsoft.visualstudio.com",
    "eng.ms",
    "msit.powerbi.com",
    "app.powerbi.com",
    "service-now.com",
    "crm.dynamics.com",
    "teams.microsoft.com",
    "teams.live.com"
  ],
  "allowedEmailDomains": ["example.com", "example.org", "example.net", "example.invalid", "invalid"]
}
